{
  "name": "xah-devchat",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Streaming AI chat UI for coders, backed by the xah.io OpenAI-compatible API.",
  "scripts": {
    "start": "node server.js",
    "host": "node scripts/host.mjs",
    "admin": "node scripts/admin.mjs",
    "test:ui": "node .smoketest/ui-server.mjs",
    "test:auth": "node .smoketest/password-run.mjs",
    "test:vault": "node .smoketest/vault-run.mjs && node .smoketest/rotate-run.mjs",
    "test:keys": "node .smoketest/sessionkey-run.mjs",
    "test:budget": "node .smoketest/budget-run.mjs",
    "test:store": "node .smoketest/chatstore-run.mjs",
    "ship": "node scripts/ship.mjs",
    "prune": "node scripts/prune.mjs",
    "migrate:turso": "node scripts/migrate-turso.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
